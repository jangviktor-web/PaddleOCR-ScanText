<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background"
    tools:context=".MainActivity">

    <!-- ═══ 顶部工具栏 ═══ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_surface"
        android:elevation="0dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinner_lang"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/md_theme_surface" />

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ═══ 图片预览区 (weight=4) ═══ -->
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:background="@color/md_theme_surface">

        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.equationl.paddleocr4android.app.OcrOverlayView
            android:id="@+id/ocr_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍照或选择图片开始识别"
                android:textSize="14sp"
                android:textColor="#80FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AA000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在识别..."
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mode_switch_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_mode_bar"
            android:padding="4dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_mode_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="框选"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_mode_active" />

            <TextView
                android:id="@+id/btn_mode_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="逐行"
                android:textSize="13sp"
                android:textColor="#80FFFFFF"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/btn_mode_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分词"
                android:textSize="13sp"
                android:textColor="#80FFFFFF"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ 底部面板 (weight=2，占屏幕下方40%) ═══ -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="12dp">

        <!-- 拖拽条 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_handle" />

        <!-- ═══ 识别前：操作按钮 ═══ -->
        <LinearLayout
            android:id="@+id/panel_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始识别"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择一张图片或拍照"
                android:textSize="13sp"
                android:textColor="@color/md_theme_outline"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_camera_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_camera"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拍照"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_onSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_gallery_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_photo"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="相册"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_onSurface" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请先加载模型"
                android:textSize="12sp"
                android:textColor="@color/md_theme_outline"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ═══ 识别后：结果展示 ═══ -->
        <LinearLayout
            android:id="@+id/panel_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 结果标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="识别结果"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_outline" />
            </LinearLayout>

            <!-- 中间内容区：文本结果 或 分词网格（滚动） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 逐行文本结果 -->
                <ScrollView
                    android:id="@+id/result_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/tv_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:lineSpacingMultiplier="1.3"
                        android:textIsSelectable="true" />
                </ScrollView>

                <!-- 分词流式布局（可滚动） -->
                <FrameLayout
                    android:id="@+id/word_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:clipToPadding="false">

                        <com.equationl.paddleocr4android.app.FlowLayout
                            android:id="@+id/flow_words"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </ScrollView>

                    <TextView
                        android:id="@+id/btn_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:text="全选"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_primary"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </FrameLayout>
            </FrameLayout>

            <!-- ═══ 底部操作栏（固定，不可滚动） ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/md_theme_surfaceContainerLowest"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/btn_action_select_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_select_all"
                        android:tint="@color/md_theme_onSurfaceVariant" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全选"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_action_copy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/md_theme_onSurfaceVariant" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="复制"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_action_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_share"
                        android:tint="@color/md_theme_onSurfaceVariant" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分享"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_action_words"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selector_ripple"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_text_fields"
                        android:tint="@color/md_theme_onSurfaceVariant" />
                    <TextView
                        android:id="@+id/tv_words_btn_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分词"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
